{
  "dev-server-init": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/session_start.js",
        "timeout": 15
      }
    ]
  },
  "command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/validate_command.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
